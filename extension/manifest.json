{
  "manifest_version": 3,
  "name": "Claude Theme",
  "version": "0.1.0",
  "description": "Your own theme and wallpaper for Claude Desktop. Loaded from the React DevTools slot when REACT_PROFILE=1.",
  "content_scripts": [
    { "matches": ["https://claude.ai/*"], "js": ["theme.js"], "run_at": "document_idle" }
  ],
  "web_accessible_resources": [
    { "resources": ["theme.json", "themes.json", "addons.json", "event.json", "scenes/*.js", "mods/*.js", "wallpapers/*"], "matches": ["https://claude.ai/*"] }
  ]
}
